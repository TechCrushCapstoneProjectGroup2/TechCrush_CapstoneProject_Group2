# Copy to .env (or .env.local) and fill in locally. Never commit real values.
# Loaded automatically by deploy/deploy.sh and scripts/ledgerpoint-cli.sh.
#
# The scripts also accept AZURE_* aliases from CI variables:
#   AZURE_RESOURCE_GROUP, AZURE_LOCATION, AZURE_STORAGE_ACCOUNT,
#   AZURE_STORAGE_CONTAINER, DEFAULT_LINK_TTL_HOURS, MAX_LINK_TTL_HOURS

RESOURCE_GROUP=rg-ledgerpoint-capstone
LOCATION=uksouth
STORAGE_ACCOUNT=
CONTAINER_NAME=financial-statements
WORKSPACE_NAME=lawledgerpointcapstone

# Share-link policy (hours).
DEFAULT_SHARE_HOURS=24
MAX_SHARE_HOURS=72

# Comma-separated Entra object IDs (optional).
TEAM_BLOB_CONTRIBUTOR_IDS=
SAS_ISSUER_PRINCIPAL_IDS=

# Local audit log. Leave empty to use ~/.ledgerpoint/audit.log.
LEDGERPOINT_LOG_DIR=
LEDGERPOINT_LOG_FILE=
